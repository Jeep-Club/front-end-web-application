# Copie para .env no desenvolvimento local. Configure as variáveis de produção na Vercel.
# URL-base da API, sem barra final. Use o endereço do ambiente de desenvolvimento autorizado.
API_URL=https://192.0.0.1
NEXT_PUBLIC_API_URL=https://192.0.0.1
# Credencial privada do frontend para a API. Configure conforme a documentação de implantação do backend.
API_FRONTEND_KEY=
# Segredo privado de assinatura. Gere um valor aleatório próprio para o ambiente.
# Nunca utilize o prefixo NEXT_PUBLIC_ neste segredo nem versione o valor real.
ACCESS=
# Use HTTPS na Vercel; HTTP pode ser usado no desenvolvimento local.
NODE_SECURE=HTTP

# Origem HTTP local do frontend em desenvolvimento. Altere a porta aqui se estiver ocupada.
APP_URL=http://127.0.0.1:3000

# Origem HTTP local do Storybook aberto pelo comando npm run storybook.
STORYBOOK_URL=http://127.0.0.1:6006

# Origem HTTP do frontend iniciado pelo Playwright; use uma porta local livre e exclusiva para testes.
PLAYWRIGHT_APP_URL=http://127.0.0.1:3100

# Origem HTTP do Storybook iniciado pelo Playwright; use uma porta local livre e exclusiva para testes.
PLAYWRIGHT_STORYBOOK_URL=http://127.0.0.1:6106

# Destino HTTP local isolado e sem serviço para o backend dos pilotos; não use a API real.
PLAYWRIGHT_API_URL=http://127.0.0.1:1

# Dados públicos exibidos nas páginas de privacidade e contato.
LEGAL_CONTROLLER_NAME=
LEGAL_CONTROLLER_DOCUMENT=
LEGAL_CONTROLLER_ADDRESS=
LEGAL_PRIVACY_EMAIL=
LEGAL_SUPPORT_EMAIL=
