# Copy to .env.local for local development. Set these in Vercel for deployments.
# API base URL, without a trailing slash.
API_URL=https://144.91.73.3
NEXT_PUBLIC_API_URL=https://144.91.73.3
# Private signing secret. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never prefix this secret with NEXT_PUBLIC_ or commit the real value.
ACCESS=
# HTTPS on Vercel; HTTP can be used with localhost during next dev.
NODE_SECURE=HTTP
